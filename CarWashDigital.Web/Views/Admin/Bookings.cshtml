@model IEnumerable<Booking>
@{
    Layout = "_LayoutApp";
    ViewData["Title"] = "Reservas";
    ViewData["ActiveSection"] = "admin/reservas";
    var allStatuses = new[] { "Confirmada", "Ingresado", "En lavado", "En secado", "Listo para recoger", "Entregada", "Cancelada" };
    var q = ViewBag.Query?.ToString() ?? "";
    var statusFilter = ViewBag.StatusFilter?.ToString() ?? "";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <h1 class="h3 fw-extrabold mb-0">Reservas</h1>
  <span class="badge text-bg-secondary">@Model.Count() registro(s)</span>
</div>

<div class="panel-card p-3 p-md-4 mb-4">
  <form method="get" action="/admin/reservas" class="row g-3 align-items-end">
    <div class="col-12 col-md-6">
      <label class="form-label small fw-semibold">Buscar por código, placa o cliente</label>
      <input name="q" value="@q" class="form-control" placeholder="Ej. ABC123, B4K-892 o nombre" />
    </div>
    <div class="col-12 col-md-4">
      <label class="form-label small fw-semibold">Estado</label>
      <select name="status" class="form-select">
        <option value="">Todos los estados</option>
        @foreach (var st in allStatuses)
        {
          <option value="@st" selected="@(statusFilter == st)">@st</option>
        }
      </select>
    </div>
    <div class="col-12 col-md-2 d-flex gap-2">
      <button type="submit" class="btn btn-sky w-100">Filtrar</button>
    </div>
  </form>
</div>

@if (Model.Any())
{
  <div class="data-table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Código</th>
          <th>Cliente</th>
          <th>Fecha y hora</th>
          <th>Servicio</th>
          <th>Vehículo</th>
          <th>Precio</th>
          <th>Estado</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        @foreach (var b in Model)
        {
          var badgeCls = b.Status == "Cancelada" ? "text-bg-danger" : (b.Status == "Listo para recoger" || b.Status == "Entregada" ? "text-bg-success" : (b.Status == "Confirmada" ? "text-bg-info" : "text-bg-warning"));
          <tr>
            <td data-label="Código"><b>@b.BookingCode</b></td>
            <td data-label="Cliente">@(b.User?.Name ?? "")</td>
            <td data-label="Fecha y hora">@b.Date.ToString("dd/MM/yyyy") · @b.TimeSlot</td>
            <td data-label="Servicio">@b.ServiceName</td>
            <td data-label="Vehículo">@b.VehicleBrand @b.VehiclePlate</td>
            <td data-label="Precio"><span class="price-tag fs-6">S/ @b.Price</span></td>
            <td data-label="Estado"><span class="badge @badgeCls">@b.Status</span></td>
            <td data-label="Acción"><a href="/admin/reservas/@b.Id" class="btn btn-sm btn-outline-info">Ver</a></td>
          </tr>
        }
      </tbody>
    </table>
  </div>
}
else
{
  <div class="panel-card p-5 text-center text-secondary">No hay reservas para mostrar con los filtros actuales.</div>
}
