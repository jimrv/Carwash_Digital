@model RegisterVm
@{
    ViewData["Title"] = "Crear cuenta";
}
<section class="container py-4 py-md-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
      <form class="panel-card p-4 p-md-5" asp-controller="Account" asp-action="Register" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        <h1 class="h3 fw-extrabold mb-1">Crear cuenta</h1>
        <p class="text-secondary small mb-4">Regístrate como cliente particular o empresa con flota.</p>

        <div class="mb-3">
          <label asp-for="Name" class="form-label fw-semibold">Nombre completo</label>
          <input asp-for="Name" class="form-control" required />
        </div>

        <div class="row g-3 mb-3">
          <div class="col-12 col-sm-6">
            <label asp-for="Email" class="form-label fw-semibold">Correo electrónico</label>
            <input asp-for="Email" type="email" class="form-control" required />
          </div>
          <div class="col-12 col-sm-6">
            <label asp-for="Phone" class="form-label fw-semibold">Teléfono</label>
            <input asp-for="Phone" class="form-control" required />
          </div>
        </div>

        <div class="mb-3">
          <label asp-for="Password" class="form-label fw-semibold">Contraseña</label>
          <input asp-for="Password" type="password" class="form-control" required />
        </div>

        <div class="mb-3">
          <label asp-for="AccountType" class="form-label fw-semibold">Tipo de cuenta</label>
          <select asp-for="AccountType" class="form-select">
            <option value="Individual">Particular</option>
            <option value="Fleet">Flota / Empresa</option>
          </select>
        </div>

        <div class="row g-3 mb-4">
          <div class="col-12 col-sm-6">
            <label asp-for="CompanyName" class="form-label fw-semibold">Empresa (opcional)</label>
            <input asp-for="CompanyName" class="form-control" />
          </div>
          <div class="col-12 col-sm-6">
            <label asp-for="Ruc" class="form-label fw-semibold">RUC (opcional)</label>
            <input asp-for="Ruc" class="form-control" />
          </div>
        </div>

        <button type="submit" class="btn btn-sky btn-lg w-100 mb-3">Registrarme</button>
        <div class="text-center small">¿Ya tienes cuenta? <a href="/login" class="fw-semibold text-decoration-none">Inicia sesión</a></div>
      </form>
    </div>
  </div>
</section>
