@model AdminDashboardVm
@{
    Layout = "_LayoutApp";
    ViewData["Title"] = "Panel operativo";
    ViewData["ActiveSection"] = "admin";
    var kpis = new[] {
        ("Reservas de hoy", Model.TodayBookingsCount),
        ("Pendientes de ingreso", Model.PendingEntryCount),
        ("En proceso", Model.InProgressCount),
        ("Listos para recoger", Model.ReadyForPickupCount),
        ("Cupos libres hoy", Model.FreeSlotsTodayCount),
        ("Canceladas", Model.CancelledCount)
    };
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <div>
    <h1 class="h3 fw-extrabold mb-1">Panel operativo</h1>
    <p class="text-secondary small mb-0">Resumen en tiempo real de bahías, turnos y entregas.</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/admin/operaciones" class="btn btn-sky btn-sm">Ir al tablero</a>
    <a href="/admin/calendario" class="btn btn-outline-info btn-sm">Ver calendario</a>
  </div>
</div>

<div class="row g-3 mb-4">
  @foreach (var k in kpis)
  {
    <div class="col-6 col-md-4 col-xl-2">
      <div class="panel-card p-3 h-100">
        <div class="kpi-num mb-1">@k.Item2</div>
        <div class="small text-secondary fw-medium">@k.Item1</div>
      </div>
    </div>
  }
</div>

<div class="panel-card p-4 mb-4">
  <h2 class="h5 fw-bold mb-3">Próximas reservas</h2>
  @if (Model.UpcomingBookings.Any())
  {
    <div class="data-table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Código</th>
            <th>Cliente</th>
            <th>Fecha y hora</th>
            <th>Servicio</th>
            <th>Vehículo</th>
            <th>Precio</th>
            <th>Estado</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var b in Model.UpcomingBookings)
          {
            <tr>
              <td data-label="Código"><b>@b.BookingCode</b></td>
              <td data-label="Cliente">@(b.User?.Name ?? "")</td>
              <td data-label="Fecha y hora">@b.Date.ToString("dd/MM/yyyy") · @b.TimeSlot</td>
              <td data-label="Servicio">@b.ServiceName</td>
              <td data-label="Vehículo">@b.VehicleBrand @b.VehiclePlate</td>
              <td data-label="Precio"><span class="price-tag fs-6">S/ @b.Price</span></td>
              <td data-label="Estado"><span class="badge text-bg-info">@b.Status</span></td>
              <td data-label="Acción"><a href="/admin/reservas/@b.Id" class="btn btn-sm btn-outline-info">Ver</a></td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
  else
  {
    <div class="text-center text-secondary py-4">No hay reservas confirmadas pendientes.</div>
  }
</div>

<div class="panel-card p-4">
  <h2 class="h6 fw-bold mb-2">Servicios más solicitados</h2>
  <p class="text-secondary small mb-0">
    @(Model.TopServices.Any() ? string.Join(" · ", Model.TopServices.Select(e => $"{e.Key}: {e.Value}")) : "Sin datos registrados todavía.")
  </p>
</div>
