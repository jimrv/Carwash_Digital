@model ConfirmStepVm
@{
    ViewData["Title"] = "Paso 4 · Confirmar reserva";
}
<section class="container py-4 py-md-5">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-7">
      <div class="panel-card p-4 p-md-5">
        <span class="badge text-bg-info mb-2">Paso 4 de 4</span>
        <h1 class="h2 fw-extrabold mb-3">Confirmar tu reserva</h1>

        <ul class="list-group list-group-flush border rounded-3 mb-4">
          <li class="list-group-item d-flex justify-content-between"><span>Servicio</span><b>@Model.Service.Name</b></li>
          <li class="list-group-item d-flex justify-content-between"><span>Vehículo</span><b>@Model.Vehicle.Brand @Model.Vehicle.Model (@Model.Vehicle.Plate)</b></li>
          <li class="list-group-item d-flex justify-content-between"><span>Fecha y hora</span><b>@Model.Date.ToString("dd/MM/yyyy") · @Model.TimeSlot</b></li>
          <li class="list-group-item d-flex justify-content-between"><span>Cliente</span><b>@Model.Customer.Name</b></li>
          <li class="list-group-item d-flex justify-content-between"><span>Total</span><span class="price-tag">S/ @Model.Price</span></li>
        </ul>

        <form asp-controller="Booking" asp-action="Confirm" method="post">
          @Html.AntiForgeryToken()
          <input type="hidden" name="ServiceId" value="@Model.Service.Id" />
          <input type="hidden" name="VehicleId" value="@Model.Vehicle.Id" />
          <input type="hidden" name="Date" value="@Model.Date.ToString("yyyy-MM-dd")" />
          <input type="hidden" name="TimeSlot" value="@Model.TimeSlot" />
          @if (Model.RescheduleId.HasValue)
          {
            <input type="hidden" name="RescheduleId" value="@Model.RescheduleId.Value" />
          }
          <button type="submit" class="btn btn-sky btn-lg w-100">Confirmar reserva</button>
        </form>
      </div>
    </div>
  </div>
</section>
