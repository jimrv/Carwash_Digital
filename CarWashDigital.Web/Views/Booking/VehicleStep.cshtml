@model VehicleStepVm
@{
    ViewData["Title"] = "Paso 2 · Elegir vehículo";
    var cats = new[] { "Sedán", "SUV", "Pick-up 4x4" };
}
<section class="container py-4 py-md-5">
  <div class="mb-4">
    <span class="badge text-bg-info mb-2">Paso 2 de 4</span>
    <h1 class="h2 fw-extrabold mb-1">Tu vehículo · @Model.Service.Name</h1>
    <p class="text-secondary mb-0">Selecciona un vehículo registrado o registra uno nuevo para continuar.</p>
  </div>

  <div class="row g-4 align-items-start">
    <div class="col-12 col-lg-7">
      <div class="panel-card p-4">
        <h2 class="h5 fw-bold mb-3">Vehículos disponibles</h2>
        @if (Model.Vehicles.Any())
        {
          <div class="list-group">
            @foreach (var v in Model.Vehicles)
            {
              <a href="/reservar/horario?serviceId=@Model.Service.Id&vehicleId=@v.Id@(Model.RescheduleId.HasValue ? $"&rescheduleId={Model.RescheduleId.Value}" : "")"
                 class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                <div>
                  <div class="fw-bold">@v.Brand @v.Model <span class="badge text-bg-info ms-1">@v.Category</span></div>
                  <div class="small text-secondary">Placa: <b>@v.Plate</b> @(string.IsNullOrWhiteSpace(v.Color) ? "" : $"· Color: {v.Color}")</div>
                </div>
                <span class="btn btn-sky btn-sm">Elegir →</span>
              </a>
            }
          </div>
        }
        else
        {
          <p class="text-secondary mb-0">Aún no tienes vehículos compatibles registrados. Registra uno en el formulario de la derecha.</p>
        }
      </div>
    </div>

    <div class="col-12 col-lg-5">
      <form class="panel-card p-4" asp-controller="Booking" asp-action="AddVehicle" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ReturnToBooking" value="true" />
        <input type="hidden" name="ServiceId" value="@Model.Service.Id" />
        <h2 class="h5 fw-bold mb-3">Registra tu vehículo</h2>

        <div class="mb-3">
          <label for="vb" class="form-label fw-semibold">Marca</label>
          <input id="vb" name="Brand" class="form-control" placeholder="Ej. Toyota" required />
        </div>

        <div class="mb-3">
          <label for="vm" class="form-label fw-semibold">Modelo</label>
          <input id="vm" name="Model" class="form-control" placeholder="Ej. Corolla" required />
        </div>

        <div class="mb-3">
          <label for="vc" class="form-label fw-semibold">Categoría</label>
          <select id="vc" name="Category" class="form-select">
            @foreach (var c in cats)
            {
              <option value="@c">@c</option>
            }
          </select>
        </div>

        <div class="mb-3">
          <label for="vp" class="form-label fw-semibold">Placa</label>
          <input id="vp" name="Plate" class="form-control" placeholder="Ej. ABC-123" required />
        </div>

        <div class="mb-4">
          <label for="vcl" class="form-label fw-semibold">Color (opcional)</label>
          <input id="vcl" name="Color" class="form-control" placeholder="Ej. Negro" />
        </div>

        <button type="submit" class="btn btn-sky w-100">Guardar y continuar</button>
      </form>
    </div>
  </div>
</section>
