@{ ViewData["Title"] = "Recuperar contraseña"; }
<div class="form">
  <img class="logo" src="/images/logo.jpg" alt="Car Wash Digital" />
  <h2>Recuperar contraseña</h2>
  <form asp-controller="Account" asp-action="ForgotPasswordPost" method="post">
    @Html.AntiForgeryToken()
    <label for="recEmail">Correo electrónico</label>
    <input id="recEmail" name="email" type="email" required />
    <p></p>
    <button type="submit" class="btn" style="width:100%">Enviar enlace</button>
  </form>
</div>
