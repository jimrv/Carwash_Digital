@model IEnumerable<ServiceItem>
@{
    ViewData["Title"] = "Paso 1 · Elegir servicio";
}
<section class="container py-4 py-md-5">
  <div class="mb-4">
    <span class="badge text-bg-info mb-2">Paso 1 de 4</span>
    <h1 class="h2 fw-extrabold mb-1">Elige el servicio</h1>
    <p class="text-secondary mb-0">Selecciona un servicio individual o un plan para flotas empresariales (+5 vehículos).</p>
  </div>
  @await Html.PartialAsync("_ServiceGrid", Model)
</section>
