@model IEnumerable<ServiceItem>
@{
    Layout = "_LayoutApp";
    ViewData["Title"] = "Servicios y tarifas";
    ViewData["ActiveSection"] = "admin/servicios";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <div>
    <h1 class="h3 fw-extrabold mb-1">Servicios y tarifas</h1>
    <p class="text-secondary small mb-0">Consulta el detalle de cada servicio y abre su vista individual para editar o desactivar.</p>
  </div>
  <div class="d-flex align-items-center gap-2">
    <span class="badge text-bg-info">@Model.Count() servicio(s)</span>
    <a href="/admin/servicios/nuevo" class="btn btn-sm btn-sky">+ Nuevo servicio</a>
  </div>
</div>

<div class="panel-card p-3 p-md-4 mb-4">
  <div class="row g-3">
    <div class="col-12 col-md-6">
      <label for="svcSearch" class="form-label small fw-semibold">Buscar servicio</label>
      <input id="svcSearch" type="search" class="form-control" placeholder="Ej. Express, Flota, Ozono..." oninput="filterAdminServices()" />
    </div>
    <div class="col-12 col-sm-6 col-md-3">
      <label for="svcType" class="form-label small fw-semibold">Tipo</label>
      <select id="svcType" class="form-select" onchange="filterAdminServices()">
        <option value="">Todos los tipos</option>
        <option value="individual">Individual</option>
        <option value="fleet">Flota (+5 autos)</option>
      </select>
    </div>
    <div class="col-12 col-sm-6 col-md-3">
      <label for="svcStatus" class="form-label small fw-semibold">Estado</label>
      <select id="svcStatus" class="form-select" onchange="filterAdminServices()">
        <option value="">Todos los estados</option>
        <option value="active">Activo</option>
        <option value="inactive">Inactivo</option>
      </select>
    </div>
  </div>
</div>

<div class="data-table-wrap">
  <table class="data-table" id="adminServicesTable">
    <thead>
      <tr>
        <th>SERVICIO</th>
        <th>TIPO</th>
        <th>DURACIÓN</th>
        <th>TARIFAS</th>
        <th>ESTADO</th>
        <th>ACCIONES</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var s in Model)
      {
        var tarifasSummary = string.Join(" · ", s.PricesByCategory.Select(kv => $"{kv.Key}: S/ {kv.Value}"));
        var searchBlob = $"{s.Name} {s.Description} {tarifasSummary}".ToLowerInvariant();
        var typeVal = s.IsFleetService ? "fleet" : "individual";
        var statusVal = s.IsActive ? "active" : "inactive";
        <tr data-search="@searchBlob" data-type="@typeVal" data-status="@statusVal">
          <td data-label="SERVICIO">
            <div class="fw-bold">@s.Name</div>
            <div class="small text-secondary">@s.Description</div>
          </td>
          <td data-label="TIPO">
            <span class="badge @(s.IsFleetService ? "text-bg-primary" : "text-bg-info")">
              @(s.IsFleetService ? "Flota (+5)" : "Individual")
            </span>
          </td>
          <td data-label="DURACIÓN">@s.DurationMinutes min</td>
          <td data-label="TARIFAS"><span class="small">@tarifasSummary</span></td>
          <td data-label="ESTADO">
            <span class="badge @(s.IsActive ? "text-bg-success" : "text-bg-secondary")">
              @(s.IsActive ? "Activo" : "Inactivo")
            </span>
          </td>
          <td data-label="ACCIONES">
            <a href="/admin/servicios/@s.Id" class="btn btn-sm btn-sky">Editar / Estado</a>
          </td>
        </tr>
      }
    </tbody>
  </table>
</div>

<script>
function filterAdminServices() {
  const q = (document.getElementById("svcSearch")?.value || "").trim().toLowerCase();
  const t = document.getElementById("svcType")?.value || "";
  const st = document.getElementById("svcStatus")?.value || "";

  document.querySelectorAll("#adminServicesTable tbody tr").forEach((tr) => {
    const blob = tr.getAttribute("data-search") || "";
    const rType = tr.getAttribute("data-type") || "";
    const rStatus = tr.getAttribute("data-status") || "";

    const okQ = !q || blob.includes(q);
    const okT = !t || rType === t;
    const okS = !st || rStatus === st;

    tr.style.display = (okQ && okT && okS) ? "" : "none";
  });
}
</script>
