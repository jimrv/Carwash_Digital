@model ScheduleStepVm
@{
    ViewData["Title"] = "Paso 3 · Elegir horario";
    var hasAnySlots = Model.Slots != null && Model.Slots.Any();
    var hasAvailableSlots = hasAnySlots && Model.Slots.Any(s => !s.IsPast && s.FreeCapacity > 0);
}
<section class="container py-4 py-md-5">
  <div class="mb-4">
    <span class="badge text-bg-info mb-2">Paso 3 de 4</span>
    <h1 class="h2 fw-extrabold mb-1">Elige fecha y bloque horario</h1>
    <p class="text-secondary mb-0">Servicio: <b>@Model.Service.Name</b> · Vehículo: <b>@Model.Vehicle.Brand @Model.Vehicle.Model (@Model.Vehicle.Plate)</b></p>
  </div>

  <div class="panel-card p-4 p-md-5">
    <form method="get" action="/reservar/horario" class="row g-3 align-items-end mb-4">
      <input type="hidden" name="serviceId" value="@Model.Service.Id" />
      <input type="hidden" name="vehicleId" value="@Model.Vehicle.Id" />
      @if (Model.RescheduleId.HasValue)
      {
        <input type="hidden" name="rescheduleId" value="@Model.RescheduleId.Value" />
      }
      <div class="col-12 col-sm-6 col-md-4">
        <label for="bDate" class="form-label fw-semibold">Fecha de atención</label>
        <input id="bDate" type="date" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" class="form-control" onchange="this.form.submit()" />
      </div>
      <div class="col-12 col-sm-6 col-md-4">
        <a href="/reservar/horario?serviceId=@Model.Service.Id&vehicleId=@Model.Vehicle.Id@(Model.RescheduleId.HasValue ? $"&rescheduleId={Model.RescheduleId.Value}" : "")"
           class="btn btn-outline-info">
          Ver disponibilidad de hoy
        </a>
      </div>
    </form>

    @if (!hasAnySlots)
    {
      <div class="alert alert-warning mb-0" role="alert">
        <div class="fw-bold mb-1">No se encuentran cupos disponibles para el @Model.SelectedDate.ToString("dd/MM/yyyy")</div>
        <div class="small">
          Por la anticipación de la fecha seleccionada o por tratarse de un día sin atención, todavía no hay bloques habilitados. Por favor selecciona una fecha más cercana en el calendario.
        </div>
      </div>
    }
    else if (!hasAvailableSlots)
    {
      <div class="alert alert-info mb-3" role="alert">
        <div class="fw-bold mb-1">Todos los cupos están ocupados o vencidos para esta fecha</div>
        <div class="small">Por favor selecciona otro día disponible para continuar con tu reserva.</div>
      </div>
    }

    @if (hasAnySlots)
    {
      <div class="row g-3">
        @foreach (var slot in Model.Slots)
        {
          var isAvail = !slot.IsPast && slot.FreeCapacity > 0;
          <div class="col-6 col-sm-4 col-md-3">
            @if (isAvail)
            {
              var url = $"/reservar/confirmacion?serviceId={Model.Service.Id}&vehicleId={Model.Vehicle.Id}&date={Model.SelectedDate:yyyy-MM-dd}&timeSlot={Uri.EscapeDataString(slot.Time)}" + (Model.RescheduleId.HasValue ? $"&rescheduleId={Model.RescheduleId.Value}" : "");
              <a href="@url" class="btn btn-outline-info w-100 py-3 d-flex flex-column align-items-center">
                <span class="fw-bold">@slot.Time</span>
                <span class="small">@slot.FreeCapacity cupo(s) libre(s)</span>
              </a>
            }
            else
            {
              <button type="button" class="btn btn-secondary w-100 py-3 d-flex flex-column align-items-center" disabled>
                <span class="fw-bold">@slot.Time</span>
                <span class="small">@(slot.IsPast ? "Horario pasado" : "Sin cupo")</span>
              </button>
            }
          </div>
        }
      </div>
    }
  </div>
</section>
