@model ClientDashboardVm
@{
    Layout = "_LayoutApp";
    ViewData["Title"] = "Mi cuenta";
    ViewData["ActiveSection"] = "cliente";
    var firstName = Model.User.Name.Split(' ')[0];
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <div>
    <h1 class="h3 fw-extrabold mb-1">Hola, @firstName</h1>
    <p class="text-secondary small mb-0">Gestiona tus próximos lavados, vehículos y seguimiento.</p>
  </div>
  <a class="btn btn-sky" href="/reservar/servicio">Reservar lavado</a>
</div>

<div class="panel-card p-4 mb-4">
  <h2 class="h5 fw-bold mb-3">Tu próxima reserva</h2>
  @if (Model.NextBooking != null)
  {
    <div class="p-3 rounded-3 border" style="background:var(--sf2);border-color:var(--bd)!important">
      <div class="fw-bold">@Model.NextBooking.ServiceName · @Model.NextBooking.Date.ToString("dd/MM/yyyy") @Model.NextBooking.TimeSlot</div>
      @await Html.PartialAsync("_BookingTracker", Model.NextBooking)
      <a href="/cliente/reservas/@Model.NextBooking.Id" class="btn btn-sm btn-outline-info mt-2">Ver detalle</a>
    </div>
  }
  else
  {
    <div class="text-center text-secondary py-4">
      <p class="mb-3">No tienes reservas próximas.</p>
      <a class="btn btn-sky btn-sm" href="/reservar/servicio">Reservar lavado</a>
    </div>
  }
</div>

<div class="panel-card p-4">
  <h2 class="h5 fw-bold mb-3">Historial de servicios</h2>
  @if (Model.CompletedBookings.Any())
  {
    <div class="data-table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Código</th>
            <th>Fecha</th>
            <th>Servicio</th>
            <th>Vehículo</th>
            <th>Precio</th>
            <th>Estado</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var b in Model.CompletedBookings)
          {
            <tr>
              <td data-label="Código"><b>@b.BookingCode</b></td>
              <td data-label="Fecha">@b.Date.ToString("dd/MM/yyyy") @b.TimeSlot</td>
              <td data-label="Servicio">@b.ServiceName</td>
              <td data-label="Vehículo">@b.VehicleBrand @b.VehiclePlate</td>
              <td data-label="Precio"><span class="price-tag fs-6">S/ @b.Price</span></td>
              <td data-label="Estado"><span class="badge text-bg-success">@b.Status</span></td>
              <td data-label="Acción"><a href="/cliente/reservas/@b.Id" class="btn btn-sm btn-outline-info">Ver</a></td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
  else
  {
    <div class="text-center text-secondary py-4">No hay reservas completadas para mostrar.</div>
  }
</div>
