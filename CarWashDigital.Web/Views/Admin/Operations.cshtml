@model IEnumerable<Booking>
@{
    Layout = "_LayoutApp";
    ViewData["Title"] = "Tablero de lavado";
    ViewData["ActiveSection"] = "admin/operaciones";
    var stages = new[] { "Confirmada", "Ingresado", "En lavado", "En secado", "Listo para recoger" };
    var nextMap = new Dictionary<string, string> {
        ["Confirmada"] = "Ingresado",
        ["Ingresado"] = "En lavado",
        ["En lavado"] = "En secado",
        ["En secado"] = "Listo para recoger",
        ["Listo para recoger"] = "Entregada"
    };
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <div>
    <h1 class="h3 fw-extrabold mb-1">Tablero de lavado</h1>
    <p class="text-secondary small mb-0">Avanza el estado de cada vehículo en bahía sin perder visibilidad de ninguna etapa.</p>
  </div>
</div>

<div class="board">
  @foreach (var st in stages)
  {
    var items = Model.Where(b => b.Status == st).ToList();
    <div class="col">
      <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <h3 class="h6 fw-bold mb-0">@st</h3>
        <span class="badge text-bg-info">@items.Count</span>
      </div>

      @if (!items.Any())
      {
        <p class="text-secondary small mb-0">Sin vehículos en esta etapa.</p>
      }

      @foreach (var b in items)
      {
        <div class="p-3 rounded-3 border mb-2" style="background:var(--sf2);border-color:var(--bd)!important">
          <div class="fw-bold small">@b.TimeSlot · @b.VehiclePlate</div>
          <div class="small">@b.VehicleBrand @b.VehicleModel</div>
          <div class="small text-secondary mb-2">@b.ServiceName</div>
          <form action="/admin/operaciones/@b.Id/avanzar" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sky btn-sm w-100">Mover a @nextMap[st]</button>
          </form>
        </div>
      }
    </div>
  }
</div>
