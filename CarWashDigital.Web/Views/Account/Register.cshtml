@model RegisterVm
@{ ViewData["Title"] = "Crear cuenta"; }
<div class="form">
  <img class="logo" src="/images/logo.jpg" alt="Car Wash Digital" />
  <h2>Crear cuenta</h2>
  <form asp-controller="Account" asp-action="Register" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="val-err"></div>

    <label asp-for="Name">Nombre completo</label>
    <input asp-for="Name" required />

    <label asp-for="Email">Correo electrónico</label>
    <input asp-for="Email" type="email" required />
    <span asp-validation-for="Email" class="val-err"></span>

    <label asp-for="Phone">Celular</label>
    <input asp-for="Phone" type="tel" required />

    <label asp-for="AccountType">Tipo de cuenta</label>
    <select asp-for="AccountType">
      <option value="Individual">Particular</option>
      <option value="Fleet">Empresa / Flota</option>
    </select>

    <label asp-for="CompanyName">Empresa / Flota (opcional)</label>
    <input asp-for="CompanyName" />

    <label asp-for="Password">Contraseña (mínimo 8 caracteres)</label>
    <input asp-for="Password" type="password" minlength="8" required />
    <span asp-validation-for="Password" class="val-err"></span>

    <label asp-for="ConfirmPassword">Confirmar contraseña</label>
    <input asp-for="ConfirmPassword" type="password" required />
    <span asp-validation-for="ConfirmPassword" class="val-err"></span>

    <p><input asp-for="AcceptTerms" type="checkbox" required style="width:auto;min-height:0" /> Acepto términos y política de privacidad</p>
    <button type="submit" class="btn" style="width:100%">Registrarme</button>
  </form>
  <p><a href="/login">Ya tengo cuenta</a></p>
</div>
