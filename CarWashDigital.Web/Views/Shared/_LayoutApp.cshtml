@{
    var isAdmin = User.IsInRole("Admin");
    var activeSection = ViewData["ActiveSection"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#0284C7" />
  <title>@(ViewData["Title"] ?? "CarWash Digital")</title>
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/site.css" />

<style id="table-header-fix">
/* Encabezado diferenciado, tipografía y alineación en todas las tablas */
table.table > thead,
table.table > thead > tr {
  background-color: var(--sf2, #e2e8f0) !important;
}
table.table > thead > tr > th,
.data-table thead th,
table thead th {
  background-color: var(--sf2, #e2e8f0) !important;
  color: var(--text, #0f172a) !important;
  font-family: "Plus Jakarta Sans", "Inter", system-ui, -apple-system, sans-serif !important;
  font-size: 0.78rem !important;
  font-weight: 700 !important;
  letter-spacing: 0.05em !important;
  text-transform: uppercase !important;
  padding: 0.9rem 1.15rem !important;
  vertical-align: middle !important;
  border-bottom: 2px solid var(--bd, rgba(100, 116, 139, 0.35)) !important;
}
table.table > tbody > tr > td,
.data-table tbody td,
table tbody td {
  padding: 0.85rem 1.15rem !important;
  vertical-align: middle !important;
}
</style>
</head>
<body>
  <div class="app-shell">
    <aside class="app-side">
      <div class="d-flex align-items-center justify-content-between gap-2 mb-2 px-1">
        <img src="/images/logo.jfif" onerror="this.onerror=null;this.src='/images/logo.svg';" alt="CarWash Digital" class="side-logo" />
        <label class="theme-switch m-0" title="Cambiar tema claro/oscuro">
          <input type="checkbox" data-theme-toggle aria-pressed="false" />
          <span class="theme-track">
            <span class="theme-icon">☀️</span>
            <span class="theme-icon">🌙</span>
            <span class="theme-knob"></span>
          </span>
        </label>
      </div>

      @if (isAdmin)
      {
        <a href="/admin" class="@(activeSection == "admin" ? "active" : "")">Panel operativo</a>
        <a href="/admin/reservas" class="@(activeSection == "admin/reservas" ? "active" : "")">Reservas</a>
        <a href="/admin/calendario" class="@(activeSection == "admin/calendario" ? "active" : "")">Calendario</a>
        <a href="/admin/operaciones" class="@(activeSection == "admin/operaciones" ? "active" : "")">Tablero de lavado</a>
        <a href="/admin/servicios" class="@(activeSection == "admin/servicios" ? "active" : "")">Servicios y tarifas</a>
        <a href="/admin/clientes" class="@(activeSection == "admin/clientes" ? "active" : "")">Clientes y flotas</a>
        <a href="/admin/config" class="@(activeSection == "admin/config" ? "active" : "")">Configuración</a>
      }
      else
      {
        <a href="/cliente" class="@(activeSection == "cliente" ? "active" : "")">Inicio</a>
        <a href="/cliente/reservas" class="@(activeSection == "cliente/reservas" ? "active" : "")">Mis reservas</a>
        <a href="/cliente/vehiculos" class="@(activeSection == "cliente/vehiculos" ? "active" : "")">Mis vehículos</a>
        <a href="/cliente/perfil" class="@(activeSection == "cliente/perfil" ? "active" : "")">Perfil</a>
        <a href="/reservar/servicio" class="@(activeSection == "reservar" ? "active" : "")">Reservar turno</a>
      }
      <a href="/">Sitio público</a>
      <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 mt-auto">
        @Html.AntiForgeryToken()
        <button type="submit" class="nav-item-btn text-danger">Cerrar sesión</button>
      </form>
    </aside>

    <main class="app-main">
      @if (TempData["Success"] != null)
      {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          @TempData["Success"]
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
      }
      @if (TempData["Error"] != null)
      {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          @TempData["Error"]
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
      }
      @RenderBody()
    </main>
  </div>

  <nav class="mobile-bar" aria-label="Navegación app móvil">
    @if (isAdmin)
    {
      <a href="/admin" class="@(activeSection == "admin" ? "active" : "")">📊<span>Panel</span></a>
      <a href="/admin/operaciones" class="@(activeSection == "admin/operaciones" ? "active" : "")">🧼<span>Tablero</span></a>
      <a href="/admin/calendario" class="@(activeSection == "admin/calendario" ? "active" : "")">📅<span>Agenda</span></a>
      <a href="/admin/reservas" class="@(activeSection == "admin/reservas" ? "active" : "")">📋<span>Reservas</span></a>
    }
    else
    {
      <a href="/cliente" class="@(activeSection == "cliente" ? "active" : "")">🏠<span>Inicio</span></a>
      <a href="/reservar/servicio" class="@(activeSection == "reservar" ? "active" : "")">📅<span>Reservar</span></a>
      <a href="/cliente/reservas" class="@(activeSection == "cliente/reservas" ? "active" : "")">📋<span>Reservas</span></a>
      <a href="/cliente/vehiculos" class="@(activeSection == "cliente/vehiculos" ? "active" : "")">🚗<span>Vehículos</span></a>
    }
  </nav>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/theme.js"></script>
</body>
</html>
