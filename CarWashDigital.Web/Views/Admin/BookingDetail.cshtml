@model Booking
@{
    Layout = "_LayoutApp";
    ViewData["Title"] = $"Reserva {Model.BookingCode}";
    ViewData["ActiveSection"] = "admin/reservas";
    var canAdvance = Model.Status != "Entregada" && Model.Status != "Cancelada";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <div>
    <a href="/admin/reservas" class="btn btn-link px-0 text-decoration-none small">← Volver a reservas</a>
    <h1 class="h3 fw-extrabold mb-0">Reserva <span style="color:var(--blue)">@Model.BookingCode</span></h1>
  </div>
  <span class="badge text-bg-info fs-6">@Model.Status</span>
</div>

<div class="row g-4 align-items-start">
  <div class="col-12 col-lg-8">
    <div class="panel-card p-4 p-md-5">
      <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 pb-3 mb-3 border-bottom">
        <div>
          <h2 class="h4 fw-bold mb-1">@Model.ServiceName</h2>
          <p class="text-secondary small mb-0">
            Cliente: <b>@(Model.User?.Name ?? "—")</b> · Vehículo: <b>@Model.VehicleBrand @Model.VehicleModel (@Model.VehiclePlate)</b>
          </p>
        </div>
        <div class="price-tag fs-4">S/ @Model.Price.ToString("0.00")</div>
      </div>

      <p class="small text-secondary mb-3">
        Fecha programada: <b>@Model.Date.ToString("dd/MM/yyyy") · @Model.TimeSlot</b>
      </p>

      @await Html.PartialAsync("_BookingTracker", Model)

      @if (canAdvance)
      {
        <form action="/admin/reservas/@Model.Id/avanzar" method="post" class="mt-4 pt-3 border-top">
          @Html.AntiForgeryToken()
          <button type="submit" class="btn btn-sky">Avanzar a siguiente etapa →</button>
        </form>
      }

      <form action="/admin/reservas/@Model.Id/observacion" method="post" class="mt-4 pt-3 border-top">
        @Html.AntiForgeryToken()
        <label class="form-label fw-semibold small">Observaciones internas</label>
        <div class="input-group">
          <input name="internalNotes" value="@Model.InternalNotes" class="form-control" placeholder="Notas operativas para el equipo..." />
          <button type="submit" class="btn btn-outline-info">Guardar nota</button>
        </div>
      </form>
    </div>
  </div>

  <div class="col-12 col-lg-4">
    <div class="panel-card p-4">
      <h2 class="h6 fw-bold mb-3">Historial</h2>
      @if (Model.History != null && Model.History.Any())
      {
        <ul class="list-group list-group-flush">
          @foreach (var h in Model.History.OrderByDescending(x => x.ChangedAt))
          {
            <li class="list-group-item px-0">
              <div class="fw-semibold small">@h.Status</div>
              <div class="small text-secondary">@h.ChangedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @h.ChangedBy</div>
            </li>
          }
        </ul>
      }
      else
      {
        <p class="text-secondary small mb-0">Sin historial registrado.</p>
      }
    </div>
  </div>
</div>
