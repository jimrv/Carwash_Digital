<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#0284C7" />
  <title>@(ViewData["Title"] ?? "CarWash Digital")</title>
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
  <header class="hd navbar navbar-expand-lg navbar-dark">
    <div class="container py-1">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/">
        <img src="/images/logo.jfif" onerror="this.onerror=null;this.src='/images/logo.svg';" alt="CarWash Digital" class="brand-logo" />
        <span class="fw-bold d-none d-sm-inline">CARWASH <span style="color:#38BDF8">DIGITAL</span></span>
      </a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Menú">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-2">
          <li class="nav-item"><a class="nav-link" href="/">Inicio</a></li>
          <li class="nav-item"><a class="nav-link" href="/servicios">Servicios</a></li>
          <li class="nav-item"><a class="nav-link" href="/como-funciona">Cómo funciona</a></li>
          <li class="nav-item"><a class="nav-link" href="/seguimiento">Seguimiento</a></li>
        </ul>

        <div class="d-flex align-items-center gap-3 flex-wrap">
          <label class="theme-switch m-0" title="Cambiar tema claro/oscuro">
            <input type="checkbox" data-theme-toggle aria-pressed="false" />
            <span class="theme-track">
              <span class="theme-icon">☀️</span>
              <span class="theme-icon">🌙</span>
              <span class="theme-knob"></span>
            </span>
          </label>

          @if (User.Identity?.IsAuthenticated == true)
          {
            var dashUrl = User.IsInRole("Admin") ? "/admin" : "/cliente";
            <a class="btn btn-outline-info btn-sm px-3" href="@dashUrl">Mi cuenta</a>
          }
          else
          {
            <a class="btn btn-outline-light btn-sm px-3" href="/login">Iniciar sesión</a>
          }
          <a class="btn btn-sky btn-sm px-3" href="/reservar/servicio">Reservar ahora</a>
        </div>
      </div>
    </div>
  </header>

  <main class="public-main">
    @RenderBody()
  </main>

  <footer class="site-footer py-5 mt-5">
    <div class="container">
      <div class="row g-4 align-items-start">
        <div class="col-12 col-md-5">
          <div class="d-flex align-items-center gap-2 mb-2">
            <img src="/images/logo.jfif" onerror="this.onerror=null;this.src='/images/logo.svg';" alt="Logo" style="height:38px;border-radius:8px" />
            <span class="fw-bold text-white fs-6">CARWASH <span style="color:#38BDF8">DIGITAL</span></span>
          </div>
          <p class="small text-light opacity-75 mb-0">Tu auto, nuestra pasión. Plataforma digital de reservas, flotas corporativas y seguimiento en tiempo real.</p>
        </div>
        <div class="col-6 col-md-4">
          <div class="fw-bold text-white small text-uppercase mb-2">Navegación</div>
          <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
            <li><a href="/servicios">Servicios individuales y flotas</a></li>
            <li><a href="/reservar/servicio">Reservar turno en línea</a></li>
            <li><a href="/seguimiento">Seguimiento por código</a></li>
            <li><a href="/como-funciona">Cómo funciona</a></li>
          </ul>
        </div>
        <div class="col-6 col-md-3">
          <div class="fw-bold text-white small text-uppercase mb-2">Atención</div>
          <p class="small text-light opacity-75 mb-1">Lunes a Sábado: 08:00 – 18:00</p>
          <p class="small text-light opacity-75 mb-0">Atención particular y flotas (+5 autos)</p>
        </div>
      </div>
      <div class="border-top mt-4 pt-3 d-flex flex-wrap justify-content-between align-items-center gap-2 small text-light opacity-75" style="border-color:rgba(56,189,248,.16)!important">
        <span>© @DateTime.Now.Year CarWash Digital · Todos los derechos reservados</span>
        <span>Lima, Perú</span>
      </div>
    </div>
  </footer>

  <nav class="mobile-bar" aria-label="Acceso rápido móvil">
    <a href="/">🏠<span>Inicio</span></a>
    <a href="/servicios">🧼<span>Servicios</span></a>
    <a href="/reservar/servicio">📅<span>Reservar</span></a>
    <a href="/seguimiento">📍<span>Estado</span></a>
    <a href="@(User.Identity?.IsAuthenticated == true ? (User.IsInRole("Admin") ? "/admin" : "/cliente") : "/login")">👤<span>Cuenta</span></a>
  </nav>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/theme.js"></script>
</body>
</html>
