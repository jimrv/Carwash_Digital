@{
    ViewData["Title"] = "Recuperar contraseña";
}
<section class="container py-4 py-md-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-7 col-lg-5">
      <form class="panel-card p-4 p-md-5" asp-controller="Account" asp-action="ForgotPassword" method="post">
        @Html.AntiForgeryToken()
        <h1 class="h3 fw-extrabold mb-1">Recuperar contraseña</h1>
        <p class="text-secondary small mb-4">Ingresa tu correo registrado para recibir instrucciones de acceso.</p>
        <div class="mb-3">
          <label for="fpEmail" class="form-label fw-semibold">Correo electrónico</label>
          <input id="fpEmail" name="email" type="email" class="form-control form-control-lg" required />
        </div>
        <button type="submit" class="btn btn-sky btn-lg w-100 mb-3">Enviar enlace</button>
        <div class="text-center small"><a href="/login" class="text-decoration-none">Volver a iniciar sesión</a></div>
      </form>
    </div>
  </div>
</section>
